# =============================================================================
# TransformIQ — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL (used by Docker Compose) ──────────────────────────────────────
POSTGRES_USER=transformiq
POSTGRES_PASSWORD=transformiq_dev
POSTGRES_DB=transformiq
POSTGRES_PORT=5432

# ── Backend — Database URL ────────────────────────────────────────────────────
# For local dev (backend running on host, DB in Docker):
DATABASE_URL=postgresql+asyncpg://transformiq:transformiq_dev@localhost:5432/transformiq

# ── Backend — Application ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Backend — CORS ────────────────────────────────────────────────────────────
# JSON list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── LLM Configuration (Phase 2 — not active in Phase 1) ─────────────────────
# Supported providers: ollama, openai, anthropic, google
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=your-api-key-here     # Required for cloud providers only
