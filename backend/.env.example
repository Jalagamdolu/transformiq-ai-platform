# =============================================================================
# TransformIQ Backend — Environment Variables (Local Development)
# =============================================================================
# Copy this file to .env (in the backend/ directory) and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Assumes PostgreSQL is running via Docker Compose on localhost:5432
DATABASE_URL=postgresql+asyncpg://transformiq:transformiq_dev@localhost:5432/transformiq

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── LLM Configuration (Phase 2 — not active in Phase 1) ─────────────────────
# Supported providers: ollama, openai, anthropic, google
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=your-api-key-here     # Required for cloud providers only
